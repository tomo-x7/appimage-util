{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["build.ts", "postject.d.ts", "src/**/*.ts"],
	"exclude": ["dist", "node_modules"]
}
